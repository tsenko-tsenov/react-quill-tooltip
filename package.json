  "description": "Inline tooltip for Quill editors: mark text via a toolbar button, preview on hover, edit on click",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "react",
    "quill",
    "react-quill",
    "tooltip",
    "editor",
    "rich-text",
    "typescript"
  ],

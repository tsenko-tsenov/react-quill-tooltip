  "license": "MIT",
  "peerDependencies": {
    "quill": "^1.3.0 || ^2.0.0",
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "quill": "^2.0.3",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist",
    "quill-tooltip.scss",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsenko-tsenov/react-quill-tooltip.git"
  },
  "bugs": {
    "url": "https://github.com/tsenko-tsenov/react-quill-tooltip/issues"
